# ==========================================
# Hạt Gạo Sky - Environment Configuration
# ==========================================

# Database
# For zero-config local run without Docker, SQLite is used:
DATABASE_URL="file:./dev.db"
# If running with PostgreSQL via Docker Compose, set:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hatgaosky_db?schema=public"

# Redis Cache (Optional, fallback to in-memory cache if not reachable)
REDIS_HOST="localhost"
REDIS_PORT=6379

# NestJS Backend API
PORT=4000
NODE_ENV="development"
JWT_SECRET="hatgaosky-super-secret-jwt-key-airline-2026"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="hatgaosky-refresh-jwt-key-airline-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# Next.js Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="vi"
NEXT_PUBLIC_AIRLINE_NAME="Hạt Gạo Sky"
NEXT_PUBLIC_AIRLINE_HOTLINE="1900 6868"
NEXT_PUBLIC_AIRLINE_EMAIL="contact@hatgaosky.vn"

# Seat Hold TTL in Minutes (default: 15)
SEAT_HOLD_TTL_MINUTES=15

# Payment Hold Deadline in Minutes (default: 30)
PAYMENT_HOLD_MINUTES=30

# Real Email Dispatch (SMTP)
# To send real emails to customer inboxes via Gmail / Brevo / SendGrid:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"Hạt Gạo Sky\" <no-reply@hatgaosky.vn>"
